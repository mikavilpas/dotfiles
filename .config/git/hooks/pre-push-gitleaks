#!/bin/sh
# Scan the commits being pushed for secrets, and refuse the push if any are
# found.
# https://github.com/gitleaks/gitleaks
#
# git feeds us one line per ref being pushed:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>

set -eu

scan="mise x gitleaks -- gitleaks"

zero=$(git hash-object --stdin </dev/null | tr 0-9a-f 0)
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # deleting a remote branch pushes no objects.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    # new branch: scan everything not already published on some remote
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # --redact so findings never print the secret itself
  $scan git --no-banner --redact --verbose --log-opts="$range" . || status=1
done

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "pre-push: secrets detected, push refused." >&2
  echo "  rewrite the offending commits, or mark a false positive with a" >&2
  echo "  gitleaks:allow comment or a .gitleaksignore fingerprint." >&2
  echo "  to push anyway: git push --no-verify" >&2
fi

exit "$status"

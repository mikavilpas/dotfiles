# Public npm settings - DO NOT ADD TOKENS HERE!
#
# This file is committed to a public repo. Auth tokens live only in ~/.npmrc,
# which is unmanaged by mise to avoid exposing the tokens.
#
# Add this to ~/.npmrc to have it read this:
#
#   globalconfig=/Users/mikavilpas/.config/npm/defaults.npmrc
#
# npm loads `globalconfig` at a lower precedence than the user file and lower
# than a project .npmrc, so these act as defaults that any project can override.
#
# Deliberately not named `npmrc`: if a future npm starts honouring
# $XDG_CONFIG_HOME/npm/npmrc as the *user* config, that would shadow ~/.npmrc
# and silently drop the auth tokens. This filename cannot be picked up by
# accident.

audit=false
fund=false
update-notifier=false

# Supply-chain defaults. npm 12 makes the script/git/remote settings its
# defaults; set here so npm 11.x behaves the same way.

# Refuse versions published in the last 3 days. Matches the current default
# Renovate cooldown.
min-release-age=3

# Block dependencies resolved from git repos or tarball URLs. A git dependency
# can ship an .npmrc that overrides the git binary path, which executes code
# during install even when install scripts are disabled.
#
# https://github.com/lirantal/npm-security-best-practices#2-block-git-based-dependencies
allow-git=none
allow-remote=none

# Hard-error on install scripts that have not been approved, rather than
# running them (very bad idea as they are commonly used for attacks).
#
# Approve per project with `npm approve-scripts`, which writes an allowScripts
# field to that project so other devs also share the same settings.
#
# https://github.com/lirantal/npm-security-best-practices#1-disable-post-install-scripts
strict-allow-scripts=true
